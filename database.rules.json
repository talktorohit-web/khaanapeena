{
  "rules": {
    "devices": {
      ".read": "auth != null && auth.uid === 'poRhEoSx12gddYxsjlBLk79xrxz2'",
      ".write": "auth != null && auth.uid === 'poRhEoSx12gddYxsjlBLk79xrxz2'",
      "$id": {
        "history": {
          ".indexOn": ["time"]
        }
      }
    },
    "config": {
      ".read": "auth != null && auth.uid === 'poRhEoSx12gddYxsjlBLk79xrxz2'",
      ".write": "auth != null && auth.uid === 'poRhEoSx12gddYxsjlBLk79xrxz2'"
    },
    "kp_restaurants": {
      "$code": {
        ".read": "!data.child('owner').exists() || (auth != null && (data.child('owner').val() === auth.uid || data.child('members').child(auth.uid).exists()))",
        ".write": "!data.exists() || !data.child('owner').exists() || (auth != null && (data.child('owner').val() === auth.uid || data.child('members').child(auth.uid).exists()))",
        "public": {
          ".read": true
        },
        "orders": {
          "$oid": {
            ".write": "!data.exists() && newData.child('source').val() === 'qr-guest'"
          }
        }
      }
    },
    "kp_users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
